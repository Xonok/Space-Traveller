{
	".html": {
		"folder": "_cache",
		"mime": "text/html; charset=utf-8",
		"compress": true
	},
	".js": {
		"folder": "",
		"mime": "text/javascript; charset=utf-8",
		"compress": true
	},
	".css": {
		"folder": "",
		"mime": "text/css; charset=utf-8",
		"compress": true
	},
	".png": {
		"folder": "",
		"mime": "image/png"
	},
	".webp": {
		"folder": "",
		"mime": "image/webp"
	},
	".jpg": {
		"folder": "",
		"mime": "image/jpeg"
	},
	".svg": {
		"folder": "",
		"mime": "image/svg+xml",
		"compress": true
	},
	".txt": {
		"folder": "txt",
		"mime": "text/plain"
	},
	".md": {
		"folder": "md",
		"mime": "text/markdown; charset=utf-8",
		"compress": true
	}
}